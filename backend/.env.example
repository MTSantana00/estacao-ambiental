# Copie para .env (ou defina no terminal / no portal da Azure). NUNCA envie o .env ao GitHub.
API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Local: banco SQLite neste arquivo (usado quando DATABASE_URL está vazia).
DATABASE_PATH=estacao.db

# Azure: conexão do PostgreSQL gerenciado. Com ela definida, a API usa o PostgreSQL.
# DATABASE_URL=postgresql://USUARIO:SENHA@NOME-DO-SERVIDOR.postgres.database.azure.com:5432/postgres?sslmode=require
